# copy this file to .env and fill values for your remote mac
export MACOS_REMOTE_USERNAME='your-remote-user'
export MACOS_REMOTE_IP='your.remote.ip.address'
export MACOS_REMOTE_SSH_IDENTITY='${HOME}/.ssh/your_remote_key'

# optional bootstrap overrides
export REPO_SSH_URL='git@github.com:samm81/downshift.git'
export TARGET_DIR='~/src/downshift'

# app config
export DOWNSHIFT_ENV='dev'

# telemetry config
export DOWNSHIFT_TELEMETRY_ENABLED='true'
export DOWNSHIFT_TELEMETRY_HEARTBEAT_INTERVAL_SEC='60'
export DOWNSHIFT_BETTERSTACK_LOGS_TOKEN='your-betterstack-logs-token'
export DOWNSHIFT_BETTERSTACK_LOGS_HOST='your-betterstack-logs-host'
export DOWNSHIFT_BETTERSTACK_ERRORS_DSN='https://<token>@<host>/<project>'

# required build-time app metadata for prod builds
export DOWNSHIFT_BUILD_CHANNEL='alpha'
export DOWNSHIFT_GITHUB_ISSUES_URL='https://github.com/samm81/downshift/issues'
export DOWNSHIFT_SUPPORT_EMAIL='email'
export DOWNSHIFT_DOWNLOAD_RELEASE_URL='https://github.com/samm81/downshift/releases/latest'

# signing / notarization config
export MACOS_CERT_P12_B64='your-base64-p12'
export MACOS_CERT_P12_PASSWORD='your-p12-password'
export MACOS_KEYCHAIN_PASSWORD='your-temp-keychain-password'
export MACOS_SIGNING_IDENTITY='Developer ID Application: Example, Inc. (TEAMID)'
export MACOS_NOTARY_APPLE_ID='name@example.com'
export MACOS_NOTARY_APP_PASSWORD='app-specific-password'
export MACOS_NOTARY_TEAM_ID='TEAMID'
